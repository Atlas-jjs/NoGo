{
  "manifest_version": 3,
  "name": "NoGo",
  "version": "1.0.0",
  "description": "A simple website blocker that lets you instantly restrict access to any site. No schedules, no timers. Just enter a URL and it’s blocked.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "res/nogo16.png",
    "32": "res/nogo32.png",
    "48": "res/nogo48.png",
    "128": "res/nogo128.png"
  }
}
